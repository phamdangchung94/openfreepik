# Neon Postgres connection (pooled connection string from Neon dashboard).
# Required for all DB operations and runtime.
DATABASE_URL=postgres://user:pass@ep-xxx.neon.tech/dbname?sslmode=require

# AES-GCM secret used to encrypt Freepik API keys at rest in the DB.
# Generate with: openssl rand -base64 32
KEY_ENCRYPTION_SECRET=

# Admin dashboard password — used by /dashboard/login.
ADMIN_PASSWORD=

# Secret used to sign admin session cookies.
# Generate with: openssl rand -base64 32
ADMIN_SESSION_SECRET=
