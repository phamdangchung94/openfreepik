# Supabase Postgres transaction-pooler connection string (port 6543).
# Required for all DB operations and runtime. Keep prepare:false in the
# postgres-js client because transaction pooling cannot use prepared statements.
DATABASE_URL=postgresql://postgres.project:pass@aws-0-region.pooler.supabase.com:6543/postgres

# Emergency write freeze for database cutovers. Set to 1 in Vercel and
# redeploy before taking a snapshot. Remove it and redeploy after DB checks.
DB_MIGRATION_MAINTENANCE_MODE=

# AES-GCM secret used to encrypt Freepik API keys at rest in the DB.
# Generate with: openssl rand -base64 32
KEY_ENCRYPTION_SECRET=

# Admin dashboard password — used by /dashboard/login.
ADMIN_PASSWORD=

# Secret used to sign admin session cookies.
# Generate with: openssl rand -base64 32
ADMIN_SESSION_SECRET=

# Bearer token Vercel Cron sends to /api/cron/purge.
# Generate with: openssl rand -base64 32
CRON_SECRET=
