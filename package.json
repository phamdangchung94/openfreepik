{
  "name": "openfreepik1",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "check:api": "tsx --env-file=.env.local scripts/check-api-key.ts",
    "check:endpoints": "tsx scripts/test-key-endpoints.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "NODE_OPTIONS='--dns-result-order=ipv4first' tsx --env-file=.env.local scripts/db-migrate.ts",
    "db:studio": "drizzle-kit studio",
    "db:seed-pricing": "NODE_OPTIONS='--dns-result-order=ipv4first' tsx --env-file=.env.local scripts/seed-pricing.ts",
    "db:status": "NODE_OPTIONS='--dns-result-order=ipv4first' tsx --env-file=.env.local scripts/db-status.ts",
    "admin:create-code": "NODE_OPTIONS='--dns-result-order=ipv4first' tsx --env-file=.env.local scripts/admin-create-code.ts",
    "admin:add-key": "NODE_OPTIONS='--dns-result-order=ipv4first' tsx --env-file=.env.local scripts/admin-add-key.ts",
    "admin:reconcile": "NODE_OPTIONS='--dns-result-order=ipv4first' tsx --env-file=.env.local scripts/reconcile-pending-charges.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1042.0",
    "@aws-sdk/s3-request-presigner": "^3.1042.0",
    "@base-ui/react": "^1.4.0",
    "@hookform/resolvers": "^5.2.2",
    "@tanstack/react-virtual": "^3.13.24",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.8.0",
    "next": "16.2.4",
    "next-themes": "^0.4.6",
    "postgres": "^3.4.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.72.1",
    "shadcn": "^4.2.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "xlsx": "^0.18.5",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@next/eslint-plugin-next": "^16.2.4",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "@vitest/coverage-v8": "^4.1.5",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.3.0",
    "eslint-config-next": "^16.2.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "typescript-eslint": "^8.59.1",
    "vitest": "^4.1.5"
  }
}
