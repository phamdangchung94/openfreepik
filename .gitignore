# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# local uploads/videos (legacy, not used in serverless mode)
/public/uploads/
/public/videos/

# typescript
*.tsbuildinfo
next-env.d.ts
.env*.local

# DB migration dumps — Neon→Supabase one-off migration 2026-05-31.
# Contains AES-encrypted blobs + customer codes + 5k usage_logs rows.
# Deleted manually post-cutover; never commit.
/migrations-data/
*.dump
*.sql.gz
